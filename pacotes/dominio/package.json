{
  "name": "dominio",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./tipos/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && pnpm tipos",
    "tipos": "tsc -p tsconfig.json --noEmit false --declaration --emitDeclarationOnly --rootDir src --outDir tipos",
    "postinstall": "pnpm tipos"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
